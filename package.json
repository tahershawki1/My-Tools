{
  "name": "survey-pdf-extractor",
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.21",
    "@types/proj4": "^2.5.6",
    "dxf-parser": "^1.1.2",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^4.4.168",
    "proj4": "^2.20.8",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.98.0"
  }
}
